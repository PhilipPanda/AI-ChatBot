NODE_ENV=development
PORT=4000
DATABASE_URL="postgresql://postgres:postgres@localhost:5432/ai_chatbot?schema=public"
JWT_ACCESS_SECRET="replace-with-a-long-access-secret-min-32-chars"
JWT_REFRESH_SECRET="replace-with-a-long-refresh-secret-min-32-chars"
# Either a 32-byte base64 string or a long random string.
ENCRYPTION_KEY="replace-with-32-byte-base64-or-strong-random-string"
CORS_ORIGIN="http://localhost:5173"
# Optional. Keep empty for localhost development.
COOKIE_DOMAIN=
ACCESS_TOKEN_EXPIRES_IN="15m"
REFRESH_TOKEN_EXPIRES_IN_DAYS=30
